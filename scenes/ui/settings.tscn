[gd_scene load_steps=5 format=3]

[ext_resource type="FontVariation" path="res://assets/fonts/Heading.tres" id="1"]
[ext_resource type="Script" path="res://scripts/ui/juicy_button.gd" id="2"]
[ext_resource type="Theme" path="res://resources/game_theme.tres" id="3"]
[ext_resource type="Script" path="res://scripts/ui/settings.gd" id="4"]

[node name="Settings" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3")
script = ExtResource("4")
mouse_filter = 0

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.10, 0.04, 0.22, 0.7)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2


[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(414, 400)

[node name="Content" type="VBoxContainer" parent="Center/Panel"]
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Center/Panel/Content"]
text = "Your happy place"
theme_override_font_sizes/font_size = 29
theme_override_colors/font_color = Color(0.2706, 0.2039, 0.3725, 1)
mouse_filter = 2
theme_override_fonts/font = ExtResource("1")
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/Content"]
text = "Settle in. Make it yours."
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.6, 0.5098, 0.6902, 1)
mouse_filter = 2
horizontal_alignment = 1

[node name="Sound" type="CheckButton" parent="Center/Panel/Content"]
custom_minimum_size = Vector2(0, 52)
text = "Sound effects"

[node name="Haptics" type="CheckButton" parent="Center/Panel/Content"]
custom_minimum_size = Vector2(0, 52)
text = "Gentle haptics"

[node name="Note" type="Label" parent="Center/Panel/Content"]
text = "Your progress saves with every color.
No timers. No pressure. Just you and color."
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5725, 0.4667, 0.651, 1)
mouse_filter = 2
horizontal_alignment = 1

[node name="Close" type="Button" parent="Center/Panel/Content"]
text = "Back to the magic"
script = ExtResource("2")
mouse_default_cursor_shape = 2
theme_type_variation = &"PurpleButton"
custom_minimum_size = Vector2(0, 48)

[connection signal="pressed" from="Center/Panel/Content/Close" to="." method="_on_close"]
[connection signal="toggled" from="Center/Panel/Content/Sound" to="." method="_on_sound"]
[connection signal="toggled" from="Center/Panel/Content/Haptics" to="." method="_on_haptics"]
